@page "/"
@model IndexModel

<h1>Registrar Evento</h1>

<div class="col-4">
    <form method="post">

        <div class="mb-3">
            <label asp-for="NovoEvento.Titulo">Título:</label>
            <input asp-for="NovoEvento.Titulo" class="form-control" />
            <span asp-validation-for="NovoEvento.Titulo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NovoEvento.Data">Data:</label>
            <input asp-for="NovoEvento.Data"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="NovoEvento.Data"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NovoEvento.Local">Local:</label>
            <input asp-for="NovoEvento.Local" class="form-control" />
            <span asp-validation-for="NovoEvento.Local"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Registrar Evento
        </button>

    </form>
</div>