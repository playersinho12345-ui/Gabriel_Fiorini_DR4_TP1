@page "/"
@model IndexModel

<h1>Concatenar Nome</h1>

<div class="col-4">
    <form method="post">

        <div class="mb-3">
            <label asp-for="Nome">Nome:</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Sobrenome">Sobrenome:</label>
            <input asp-for="Sobrenome" type="text"
                   class="form-control" />
            <span asp-validation-for="Sobrenome" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Concatenar
        </button>

    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Resultado))
{
    <h2>Nome concatenado:</h2>
    <p>Resultado: @Model.Resultado</p>
}


